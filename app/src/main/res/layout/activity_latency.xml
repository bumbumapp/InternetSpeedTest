<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/newbg"
    android:orientation="vertical">

    <include layout="@layout/tool_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/ToolCardText"
                android:layout_marginTop="0dp"
                android:text="@string/latency_target" />

            <Spinner
                android:id="@+id/latency_target"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/is_card"
                android:popupBackground="#181B25" />

            <EditText
                android:id="@+id/latency_custom"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/is_card"
                android:hint="@string/latency_custom_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/maintextcolor"
                android:textColorHint="@color/subtext"
                android:visibility="gone" />

            <TextView
                android:id="@+id/latency_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/jakarta_extrabold"
                android:gravity="center"
                android:text="— ms"
                android:textColor="@color/maintextcolor"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/latency_quality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/cone"
                android:textSize="16sp" />

            <com.code.bumbumapps.netspeed.tools.LatencyChartView
                android:id="@+id/latency_chart"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/is_card"
                android:contentDescription="@string/latency_chart_desc" />

            <TextView
                android:id="@+id/latency_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/is_card"
                android:lineSpacingExtra="6dp"
                android:padding="16dp"
                android:textColor="@color/maintextcolor"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/tool_action"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/is_button"
        android:fontFamily="@font/jakarta_bold"
        android:stateListAnimator="@null"
        android:text="@string/latency_start"
        android:textAllCaps="false"
        android:textColor="@color/is_button_text"
        android:textSize="16sp" />
</LinearLayout>
